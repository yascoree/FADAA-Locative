POSTGRES_USER=gestion_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fadaa_locative_db
POSTGRES_HOST_PORT=5435

DATABASE_URL=postgresql://gestion_user:change_me@localhost:5435/fadaa_locative_db
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Notifications push (Firebase Cloud Messaging) : chemin vers le JSON de compte de
# service (Firebase Console > Paramètres du projet > Comptes de service > Générer
# une nouvelle clé privée). Laisser vide désactive juste l'envoi des push.
FIREBASE_CREDENTIALS_PATH=
PUSH_ALERT_DAYS_BEFORE=3
PUSH_OVERDUE_REMINDER_EVERY_DAYS=3
