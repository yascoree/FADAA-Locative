# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
gestion-location-frontend/node_modules
/.pnp
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
gestion-location-frontend/out/
gestion-location-frontend/.next/
# production
/build
gestion-location-frontend/build
# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
gestion-location-backend/.env*
# vercel
.vercel

# python
gestion-location-backend/venv/
gestion-location-backend/__pycache__/
gestion-location-backend/**/__pycache__/
gestion-location-backend/**/*.pyc

# typescript
*.tsbuildinfo
next-env.d.ts
