# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
gestion-location-frontend/node_modules
/.pnp
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
gestion-location-frontend/out/
gestion-location-frontend/.next/
# production
/build
gestion-location-frontend/build
# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
gestion-location-backend/.env*
!.env.example
!gestion-location-backend/.env.example
# vercel
.vercel

# python
gestion-location-backend/venv/
gestion-location-backend/__pycache__/
gestion-location-backend/**/__pycache__/
gestion-location-backend/**/*.pyc
gestion-location-backend/*.log
gestion-location-frontend/*.log

# fichiers générés (photos utilisateurs, PDF de quittances contenant des données personnelles)
gestion-location-backend/uploads/
gestion-location-backend/storage/

# clé de compte de service Firebase (secret — ne doit jamais être committée)
gestion-location-backend/*firebase*.json
gestion-location-backend/serviceAccountKey.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Coding
.vscode
.claude